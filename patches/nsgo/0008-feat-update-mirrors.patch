+//go:build darwin && !ios && nsgo_update_mirrors && !nsgo_steam
+
+package updates
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestSparkleRelayResumesAfterTruncatedSource(t *testing.T) {
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/unavailable":
+			w.WriteHeader(http.StatusServiceUnavailable)
+		case "/partial":
+			w.Header().Set("Content-Length", "10")
+			fmt.Fprint(w, "1234")
+		case "/complete":
+			if r.Header.Get("Range") != "bytes=4-" {
+				w.WriteHeader(http.StatusRequestedRangeNotSatisfiable)
+				return
+			}
+			w.Header().Set("Content-Range", "bytes 4-9/10")
+			w.WriteHeader(http.StatusPartialContent)
+			fmt.Fprint(w, "567890")
+		}
+	}))
+	t.Cleanup(origin.Close)
+	router := httptest.NewRecorder()
+	streamPackage(router, httptest.NewRequest(http.MethodGet, "/", nil), origin.Client(),
+		[]string{origin.URL + "/unavailable", origin.URL + "/partial", origin.URL + "/complete"}, 10)
+	if router.Code != 200 || router.Body.String() != "1234567890" {
+		t.Fatalf("relay sent status %d, body %q", router.Code, router.Body.String())
+	}
+}
