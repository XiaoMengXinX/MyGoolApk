index b38c8a16f..06c15ccab 100644
--- a/cmd/nsgo/plistvalue.go
+++ b/cmd/nsgo/plistvalue.go
@@ -40,6 +40,40 @@ func (p *project) InfoPlist() (map[string]any, error) {
 	return info, nil
 }
 
+// sparkleMirrorInfo allows Sparkle's HTTP requests to the loopback relay
+// without relaxing ATS for remote hosts.
+func (p *project) sparkleMirrorInfo() (map[string]any, error) {
+	dict := func(parent map[string]any, key string) (map[string]any, error) {
+		value, exists := parent[key]
+		if existing, ok := value.(map[string]any); ok {
+			return maps.Clone(existing), nil
+		}
+		if exists {
+			return nil, fmt.Errorf("apple.info: %s must be a dictionary", key)
+		}
+		return make(map[string]any), nil
+	}
+	info := make(map[string]any, len(p.Apple.Info)+1)
+	maps.Copy(info, p.Apple.Info)
+	ats, err := dict(info, "NSAppTransportSecurity")
+	if err != nil {
+		return nil, err
+	}
+	domains, err := dict(ats, "NSExceptionDomains")
+	if err != nil {
+		return nil, err
+	}
+	loopback, err := dict(domains, "127.0.0.1")
+	if err != nil {
+		return nil, err
+	}
+	loopback["NSExceptionAllowsInsecureHTTPLoads"] = true
+	domains["127.0.0.1"] = loopback
+	ats["NSExceptionDomains"] = domains
+	info["NSAppTransportSecurity"] = ats
+	return info, nil
+}
+
 // InfoValue writes the types apple.info can express in an Info.plist.
 // Keep strings as strings: YAML booleans and numbers have their own
 // native types. Reject unsupported values rather than stringify them.
