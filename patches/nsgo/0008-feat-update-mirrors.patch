diff --git a/internal/platform/updates/mirrors.go b/internal/platform/updates/mirrors.go
new file mode 100644
index 000000000..b65f13df4
--- /dev/null
+++ b/internal/platform/updates/mirrors.go
@@ -0,0 +1,70 @@
+package updates
+
+import (
+	"context"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// A stalled mirror should give the next source a turn, while a download
+// making progress keeps the existing overall download deadline.
+const mirrorIdleTimeout = 15 * time.Second
+
+// MirrorDownloadWait is the extra idle time a local Sparkle request needs while
+// the relay tries the configured upstreams.
+func (c Config) MirrorDownloadWait() time.Duration {
+	return time.Duration(strings.Count(c.Mirrors, ",")+1) * mirrorIdleTimeout
+}
+
+func sources(original, mirrors string) []string {
+	if mirrors == "" || !strings.HasPrefix(original, "https://") {
+		return []string{original}
+	}
+	prefixes := strings.Split(mirrors, ",")
+	for i, prefix := range prefixes {
+		prefixes[i] = prefix + original
+	}
+	return append(prefixes, original)
+}
+
+// An appcast can link to a download on another server. Leave those URLs on
+// their own origin instead of passing them to the configured mirrors.
+func (c Config) packageMirrors(download string) string {
+	if c.Mirrors == "" {
+		return ""
+	}
+	feed, _ := url.Parse(c.Feed)
+	asset, err := url.Parse(download)
+	if err != nil || asset.Scheme != "https" || asset.User != nil || feed == nil ||
+		!strings.EqualFold(asset.Host, feed.Host) {
+		return ""
+	}
+	return c.Mirrors
+}
+
+func fetchAppcast(ctx context.Context, c Config) ([]byte, []Item, error) {
+	urls := sources(c.Feed, c.Mirrors)
+	var last error
+	for i, source := range urls {
+		if err := ctx.Err(); err != nil {
+			return nil, nil, err
+		}
+		attempt, cancel := ctx, func() {}
+		if i < len(urls)-1 {
+			// Leave part of the check's budget for each later source.
+			attempt, cancel = context.WithTimeout(ctx, timeout/time.Duration(len(urls)))
+		}
+		body, err := get(attempt, source)
+		cancel()
+		if err == nil {
+			var items []Item
+			items, err = ParseAppcastItems(body)
+			if err == nil {
+				return body, items, nil
+			}
+		}
+		last = err
+	}
+	return nil, nil, last
+}
diff --git a/internal/platform/updates/sparkle_sources.go b/internal/platform/updates/sparkle_sources.go
new file mode 100644
index 000000000..4d8eebeee
--- /dev/null
+++ b/internal/platform/updates/sparkle_sources.go
@@ -0,0 +1,171 @@
+//go:build darwin && !ios && nsgo_update_mirrors && !nsgo_steam
+
+package updates
+
+import (
+	"context"
+	"crypto/rand"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"path"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// ServeSparkleSources gives the native updater one local URL for each
+// resource. The appcast reaches Sparkle byte for byte, and Sparkle checks
+// the package's signature as usual.
+func ServeSparkleSources(c Config) (feed string, download func(string, int64) string, close func(), err error) {
+	if !strings.HasPrefix(c.Feed, "https://") {
+		return "", nil, nil, fmt.Errorf("the Sparkle mirror feed must use HTTPS")
+	}
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		return "", nil, nil, err
+	}
+	prefix := "/" + rand.Text() + "/"
+	base := "http://" + listener.Addr().String()
+	transport := &http.Transport{Proxy: http.ProxyFromEnvironment}
+	client := &http.Client{Transport: transport, CheckRedirect: func(req *http.Request, via []*http.Request) error {
+		if req.URL.Scheme != "https" || len(via) >= 10 {
+			return http.ErrUseLastResponse
+		}
+		return nil
+	}}
+	type asset struct {
+		path, url string
+		size      int64
+	}
+	var mu sync.Mutex
+	var selected asset
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET "+prefix+"appcast.xml", func(w http.ResponseWriter, r *http.Request) {
+		ctx, cancel := context.WithTimeout(r.Context(), timeout)
+		defer cancel()
+		body, _, err := fetchAppcast(ctx, c)
+		if err != nil {
+			http.Error(w, "could not read the appcast", http.StatusBadGateway)
+			return
+		}
+		w.Header().Set("Content-Type", "application/rss+xml")
+		w.Header().Set("Cache-Control", "no-store")
+		_, _ = w.Write(body)
+	})
+	mux.HandleFunc("GET "+prefix+"package/", func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		pkg := selected
+		mu.Unlock()
+		if r.URL.EscapedPath() != pkg.path {
+			http.NotFound(w, r)
+			return
+		}
+		streamPackage(w, r, client, sources(pkg.url, c.Mirrors), pkg.size)
+	})
+	server := &http.Server{Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	go func() { _ = server.Serve(listener) }()
+	download = func(original string, size int64) string {
+		if c.packageMirrors(original) == "" {
+			return ""
+		}
+		u, _ := url.Parse(original)
+		localPath := prefix + "package/" + rand.Text() + "/" + url.PathEscape(path.Base(u.Path))
+		mu.Lock()
+		selected = asset{path: localPath, url: original, size: size}
+		mu.Unlock()
+		return base + localPath
+	}
+	return base + prefix + "appcast.xml", download, func() {
+		_ = server.Close()
+		transport.CloseIdleConnections()
+	}, nil
+}
+
+func streamPackage(w http.ResponseWriter, r *http.Request, client *http.Client, urls []string, size int64) {
+	var sent int64
+	started := false
+	for _, source := range urls {
+		if r.Context().Err() != nil {
+			return
+		}
+		ctx, cancel := context.WithCancel(r.Context())
+		timer := time.AfterFunc(mirrorIdleTimeout, cancel)
+		n, complete := streamPackageSource(ctx, w, client, source, sent, &size, &started, timer)
+		cancel()
+		timer.Stop()
+		if complete {
+			return
+		}
+		sent += n
+		// Only a source that can supply the remaining bytes can resume a
+		// partial response. Sparkle verifies the final bytes before install.
+		if sent > 0 && size <= 0 {
+			break
+		}
+	}
+	if started {
+		panic(http.ErrAbortHandler)
+	}
+	http.Error(w, "could not download the update", http.StatusBadGateway)
+}
+
+func streamPackageSource(ctx context.Context, w http.ResponseWriter, client *http.Client, source string, offset int64, size *int64, started *bool, timer *time.Timer) (int64, bool) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, source, nil)
+	if err != nil {
+		return 0, false
+	}
+	req.Header.Set("Accept-Encoding", "identity")
+	req.Header.Set("Cache-Control", "no-cache")
+	if offset > 0 {
+		req.Header.Set("Range", fmt.Sprintf("bytes=%d-", offset))
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return 0, false
+	}
+	defer resp.Body.Close()
+	if offset == 0 {
+		if resp.StatusCode != http.StatusOK || strings.HasPrefix(resp.Header.Get("Content-Type"), "text/html") ||
+			(*size > 0 && resp.ContentLength >= 0 && *size != resp.ContentLength) {
+			return 0, false
+		}
+		if *size <= 0 {
+			*size = resp.ContentLength
+		}
+	} else if resp.StatusCode != http.StatusPartialContent ||
+		resp.Header.Get("Content-Range") != fmt.Sprintf("bytes %d-%d/%d", offset, *size-1, *size) {
+		return 0, false
+	}
+	if !*started {
+		w.Header().Set("Content-Type", "application/octet-stream")
+		w.Header().Set("Cache-Control", "no-store")
+		if *size >= 0 {
+			w.Header().Set("Content-Length", strconv.FormatInt(*size, 10))
+		}
+		*started = true
+	}
+	body := progressingBody{resp.Body, timer}
+	if *size >= 0 {
+		n, err := io.CopyN(w, body, *size-offset)
+		return n, err == nil
+	}
+	n, err := io.Copy(w, body)
+	return n, err == nil
+}
+
+type progressingBody struct {
+	io.Reader
+	timer *time.Timer
+}
+
+func (b progressingBody) Read(p []byte) (int, error) {
+	n, err := b.Reader.Read(p)
+	if n > 0 {
+		b.timer.Reset(mirrorIdleTimeout)
+	}
+	return n, err
+}
