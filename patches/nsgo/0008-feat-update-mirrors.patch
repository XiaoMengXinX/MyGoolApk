+func TestUpdateMirrorConfig(t *testing.T) {
+	p, _ := updatingProject(t, ", mirrors: ['https://one.example/', 'https://two.example/']")
+	if err := p.checkUpdateFeed("macos_arm64"); err != nil {
+		t.Fatal(err)
+	}
+	flags := strings.Join(p.updateLdflags([]string{"GOOS=android", "GOARCH=arm64"}), " ")
+	if !strings.Contains(flags, "updateMirrors=https://one.example/,https://two.example/") {
+		t.Fatalf("build flags: %s", flags)
+	}
+	info, err := p.sparkleMirrorInfo()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ats, err := p.InfoValue(info["NSAppTransportSecurity"])
+	if err != nil || !strings.Contains(ats, "<key>127.0.0.1</key><dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/>") {
+		t.Fatalf("loopback ATS exception = %s, %v", ats, err)
+	}
+	p.Updates.Mirrors = []string{"http://one.example/"}
+	if err := p.checkUpdateFeed("macos_arm64"); err == nil {
+		t.Fatal("unencrypted mirror accepted")
+	}
