diff --git a/core/layout.go b/core/layout.go
index 1679f43fb..600d26b5b 100644
--- a/core/layout.go
+++ b/core/layout.go
@@ -251,7 +251,10 @@ func (n *node) layoutStyle() layout.Style {
 
 	switch s.Display {
 	case DisplayNone:
-		l.Display = layout.DisplayNone
+		// A covered screen keeps its place in the layout: only its view hides.
+		if !n.covered {
+			l.Display = layout.DisplayNone
+		}
 	case DisplayGrid:
 		l.Display = layout.DisplayGrid
 	case DisplayBlock:
@@ -653,7 +656,7 @@ func (t *Tree) syncFrames(n *node) {
 		}
 		// As NSH's frame walk does, a hidden subtree gets empty frames and
 		// content boxes, whatever its layout kept.
-		hidden := n.hidden || c.style.Display == DisplayNone
+		hidden := n.hidden || c.style.Display == DisplayNone && !c.covered
 		shown := hidden != c.hidden
 		if shown {
 			c.hidden = hidden
diff --git a/core/nav_test.go b/core/nav_test.go
index cfea76956..dae4043cc 100644
--- a/core/nav_test.go
+++ b/core/nav_test.go
@@ -374,8 +374,9 @@ func TestBackPreviewNamesTheScreenBackPops(t *testing.T) {
