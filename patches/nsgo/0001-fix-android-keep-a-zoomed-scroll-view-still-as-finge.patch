From 06d44e8c2e49c5a9d7ec0bdb31b1dd7cb4fb8280 Mon Sep 17 00:00:00 2001
From: xiaomengxin <xibaole2333@gmail.com>
Date: Thu, 26 Nov 2026 03:20:15 +0800
Subject: [PATCH 1/3] fix(android): keep a zoomed scroll view still as fingers
 land and lift

---
 .../android/java/dev/oneo/nsgo/Scrolling.java | 41 ++++++++++++++++---
 1 file changed, 35 insertions(+), 6 deletions(-)

diff --git a/internal/platform/android/java/dev/oneo/nsgo/Scrolling.java b/internal/platform/android/java/dev/oneo/nsgo/Scrolling.java
index eab127df..f2b1ef33 100644
--- a/internal/platform/android/java/dev/oneo/nsgo/Scrolling.java
+++ b/internal/platform/android/java/dev/oneo/nsgo/Scrolling.java
@@ -1176,6 +1176,10 @@ final class Scrolling {
                     nest();
                     return false;
                 case MotionEvent.ACTION_POINTER_DOWN:
+                    // The view takes the touch at this event, which onTouchEvent
+                    // then never sees: the pan goes on from the fingers' middle.
+                    lastX = middleX(e, -1);
+                    lastY = middleY(e, -1);
                     return true;
                 case MotionEvent.ACTION_MOVE:
                     return Math.hypot(e.getX() - downX, e.getY() - downY) > slop;
@@ -1183,18 +1187,43 @@ final class Scrolling {
             return false;
         }
 
+        /** The middle of e's fingers but the one at index skip (-1 for none). */
+        private static float middleX(MotionEvent e, int skip) {
+            float sum = 0;
+            int n = 0;
+            for (int i = 0; i < e.getPointerCount(); i++) {
+                if (i != skip) {
+                    sum += e.getX(i);
+                    n++;
+                }
+            }
+            return sum / n;
+        }
+
+        private static float middleY(MotionEvent e, int skip) {
+            float sum = 0;
+            int n = 0;
+            for (int i = 0; i < e.getPointerCount(); i++) {
+                if (i != skip) {
+                    sum += e.getY(i);
+                    n++;
+                }
+            }
+            return sum / n;
+        }
+
         @Override
         public boolean onTouchEvent(MotionEvent e) {
             if (config.noScroll) return false;
             scale.onTouchEvent(e);
             if (tracker[0] == null) tracker[0] = android.view.VelocityTracker.obtain();
             tracker[0].addMovement(e);
-            float x = e.getX(), y = e.getY();
-            if (e.getPointerCount() > 1) {
-                // The fingers' middle pans while they pinch.
-                x = (e.getX(0) + e.getX(1)) / 2;
-                y = (e.getY(0) + e.getY(1)) / 2;
-            }
+            // The fingers' middle pans while they pinch. A finger going up is
+            // still in its event: the middle of those that stay is where the
+            // next move goes on from, or the content jumps by half the
+            // fingers' spread as one lifts.
+            int up = e.getActionMasked() == MotionEvent.ACTION_POINTER_UP ? e.getActionIndex() : -1;
+            float x = middleX(e, up), y = middleY(e, up);
             switch (e.getActionMasked()) {
                 case MotionEvent.ACTION_DOWN:
                     downX = lastX = x;
