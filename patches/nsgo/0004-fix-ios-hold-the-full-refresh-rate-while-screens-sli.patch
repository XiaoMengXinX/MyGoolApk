From 788fb1f2706a4a84df4ba488787975f6dad3cbe3 Mon Sep 17 00:00:00 2001
From: xiaomengxin <xibaole2333@gmail.com>
Date: Fri, 27 Nov 2026 12:32:29 +0800
Subject: [PATCH 4/5] fix(ios): hold the full refresh rate while screens slide

---
 internal/platform/ios/media.go | 19 +++++++++++++++++++
 internal/platform/ios/nav.go   |  7 +++++++
 2 files changed, 26 insertions(+)

diff --git a/internal/platform/ios/media.go b/internal/platform/ios/media.go
index 90e6a9de..3ee40d22 100644
--- a/internal/platform/ios/media.go
+++ b/internal/platform/ios/media.go
@@ -64,6 +64,25 @@ func (s *surface) startTicking() {
 	s.link.Send(sel("setPaused:"), false)
 }
 
+// fullRateLink starts a display link calling action on target that asks
+// for the screen's full rate, retained, for motion the app's own frame
+// clock does not run: a ProMotion iPhone otherwise shows Core Animation's
+// animations and moves made from touches at 60 Hz. Stop it with
+// stopLink.
+func (s *surface) fullRateLink(target objc.ID, action objc.SEL) objc.ID {
+	link := objc.ID(apple.Class("CADisplayLink")).Send(sel("displayLinkWithTarget:selector:"), target, action)
+	rate := float32(max(s.screenRate(), 60))
+	link.Send(sel("setPreferredFrameRateRange:"), apple.CAFrameRateRange{Minimum: min(80, rate), Maximum: rate, Preferred: rate})
+	link.Send(sel("addToRunLoop:forMode:"), objc.ID(apple.Class("NSRunLoop")).Send(sel("mainRunLoop")), apple.CommonModes())
+	return link.Send(sel("retain"))
+}
+
+// stopLink stops and releases a link fullRateLink started.
+func stopLink(link objc.ID) {
+	link.Send(sel("invalidate"))
+	link.Send(selRelease)
+}
+
 func (s *surface) screenRate() int {
 	screen := s.window.Send(sel("screen"))
 	if screen == 0 {
diff --git a/internal/platform/ios/nav.go b/internal/platform/ios/nav.go
index 9450ac6d..0a9eef65 100644
--- a/internal/platform/ios/nav.go
+++ b/internal/platform/ios/nav.go
@@ -84,6 +84,7 @@ var (
 	sheets                                       = map[objc.ID]*view{}
 	titleWraps                                   = map[objc.ID]*titleWrapState{}
 	selEdgeSwipe                                 = sel("nsgoEdgeSwipe:")
+	selKeepRate                                  = sel("nsgoKeepRate:")
 	selHeaderItem                                = sel("nsgoHeaderItem:")
 )
 
@@ -215,6 +216,8 @@ func registerNav() {
 func navMethods() []objc.MethodDef {
 	return []objc.MethodDef{
 		{Cmd: selEdgeSwipe, Fn: edgeSwiped},
+		// A slide's display link only keeps the screen's rate up.
+		{Cmd: selKeepRate, Fn: func(objc.ID, objc.SEL, objc.ID) {}},
 		{Cmd: selHeaderItem, Fn: headerItemPressed},
 		{Cmd: sel("safeAreaInsetsDidChange"), Fn: func(self objc.ID, cmd objc.SEL) {
 			apple.Super(self, cmd)
@@ -793,6 +796,8 @@ type slide struct {
 	// fade crossfades the top screen in or out instead of moving it
 	// (ScreenFade).
 	fade bool
+	// link holds the screen at its full rate while the slide lasts.
+	link objc.ID
 }
 
 // stackChange is a stack whose screens a batch changes: the screen it
@@ -1017,6 +1022,7 @@ func (s *surface) slideWidth(sl *slide) float64 {
 // startSlide puts the dimming view under the top screen of sl.
 func (s *surface) startSlide(sl *slide) {
 	s.slides[sl.stack] = sl
+	sl.link = s.fullRateLink(sl.stack.native, selKeepRate)
 	sl.dim = objc.ID(apple.Class("UIView")).Send(selNew)
 	sl.dim.Send(sel("setBackgroundColor:"), objc.ID(apple.Class("UIColor")).Send(sel("blackColor")))
 	sl.dim.Send(sel("setUserInteractionEnabled:"), false)
@@ -1091,6 +1097,7 @@ func (s *surface) endSlide(sl *slide) {
 		return
 	}
 	sl.ended = true
+	stopLink(sl.link)
 	if s.slides[sl.stack] == sl {
 		delete(s.slides, sl.stack)
 	}
