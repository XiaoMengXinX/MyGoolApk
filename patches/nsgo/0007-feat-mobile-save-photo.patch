@@ -0,0 +1,38 @@
+package core
+
+import (
+	"testing"
+
+	"github.com/nsgo-dev/nsgo/internal/driver"
+)
+
+func TestSavePhotoLibraryResults(t *testing.T) {
+	for _, os := range []OS{OSIOS, OSAndroid} {
+		t.Run(string(os), func(t *testing.T) {
+			var cx *Scope
+			h := newHost(t, Size{Width: 100, Height: 100}, func(c *Scope) Node { cx = c; return View{} })
+			h.commit()
+			h.tree.SetEnvironment(Environment{OS: os})
+			for _, message := range []string{"", "photo library access denied"} {
+				answered := false
+				cx.SavePhoto(PhotoSaveOptions{Name: "photo.gif", Data: []byte("GIF89a")}, func(saved bool, _ string, err error) {
+					answered = true
+					if saved != (message == "") || (err != nil) != (message != "") {
+						t.Errorf("saved=%v error=%v for %q", saved, err, message)
+					}
+				})
+				it := command(h.commit(), driver.ItemSaveFile)
+				if it == nil || !it.Save.Photo || it.Save.MIME != "image/gif" {
+					t.Fatalf("photo request = %+v", it)
+				}
+				if answered {
+					t.Fatal("save completed before the photo library answered")
+				}
+				h.tree.Dispatch(driver.Event{Kind: driver.EventFiles, Count: it.Count, Finished: message == "", Text: message})
+				if !answered {
+					t.Fatal("photo library result was not delivered")
+				}
+			}
+		})
+	}
+}
