diff --git a/internal/platform/ios/photos.go b/internal/platform/ios/photos.go
new file mode 100644
index 00000000..7157f574
--- /dev/null
+++ b/internal/platform/ios/photos.go
@@ -0,0 +1,85 @@
+//go:build ios
+
+package ios
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"sync"
+
+	"github.com/ebitengine/purego"
+	"github.com/ebitengine/purego/objc"
+	"github.com/nsgo-dev/nsgo/internal/driver"
+	"github.com/nsgo-dev/nsgo/internal/platform/apple"
+	"github.com/nsgo-dev/nsgo/internal/platform/objcblock"
+)
+
+var photoLibrary = sync.OnceValues(func() (objc.ID, error) {
+	_, err := purego.Dlopen("/System/Library/Frameworks/Photos.framework/Photos", purego.RTLD_NOW|purego.RTLD_GLOBAL)
+	if err != nil {
+		return 0, err
+	}
+	return objc.ID(apple.Class("PHPhotoLibrary")), nil
+})
+
+func (s *surface) savePhoto(r driver.SaveRequest, id uint32) {
+	answer := func(saved bool, message string) {
+		s.engine.Dispatch(driver.Event{Kind: driver.EventFiles, Count: id, Finished: saved, Text: message})
+	}
+	if onTV() {
+		answer(false, "photo library saving is unavailable on tvOS")
+		return
+	}
+	libraryClass, err := photoLibrary()
+	if err != nil {
+		answer(false, err.Error())
+		return
+	}
+	write := func(status int64) {
+		if status != 3 && status != 4 {
+			answer(false, "photo library access denied")
+			return
+		}
+		path, err := r.Stage(filepath.Join(os.TempDir(), "nsgo-photo"))
+		if err != nil {
+			answer(false, err.Error())
+			return
+		}
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		pool := objc.ID(apple.Class("NSAutoreleasePool")).Send(selNew)
+		defer pool.Send(sel("drain"))
+		changes := objcblock.New(func(objc.Block) {
+			request := objc.ID(apple.Class("PHAssetCreationRequest")).Send(sel("creationRequestForAsset"))
+			options := objc.ID(apple.Class("PHAssetResourceCreationOptions")).Send(selAlloc).Send(sel("init"))
+			options.Send(sel("setOriginalFilename:"), apple.NSString(r.Name))
+			url := objc.ID(apple.Class("NSURL")).Send(sel("fileURLWithPath:"), apple.NSString(path))
+			request.Send(sel("addResourceWithType:fileURL:options:"), int64(1), url, options)
+			options.Send(sel("release"))
+		})
+		completed := objcblock.New(func(_ objc.Block, success bool, err objc.ID) {
+			os.RemoveAll(filepath.Dir(path))
+			message := ""
+			if !success {
+				message = "the photo library could not save the image"
+				if err != 0 {
+					message = apple.GoString(err.Send(sel("localizedDescription")))
+				}
+			}
+			answer(success, message)
+		})
+		libraryClass.Send(sel("sharedPhotoLibrary")).Send(sel("performChanges:completionHandler:"), changes, completed)
+		changes.Release()
+		completed.Release()
+	}
+	const addOnly = int64(1)
+	status := objc.Send[int64](libraryClass, sel("authorizationStatusForAccessLevel:"), addOnly)
+	if status != 0 {
+		go write(status)
+		return
+	}
+	permission := objcblock.New(func(_ objc.Block, status int64) { go write(status) })
+	libraryClass.Send(sel("requestAuthorizationForAccessLevel:handler:"), addOnly, permission)
+	permission.Release()
+}
