diff --git a/internal/platform/ios/scrolltarget.go b/internal/platform/ios/scrolltarget.go
new file mode 100644
index 00000000..ff983638
--- /dev/null
+++ b/internal/platform/ios/scrolltarget.go
@@ -0,0 +1,238 @@
+//go:build ios
+
+package ios
+
+import (
+	"math"
+
+	"github.com/ebitengine/purego/objc"
+
+	"github.com/nsgo-dev/nsgo/internal/driver"
+	"github.com/nsgo-dev/nsgo/internal/platform/apple"
+)
+
+// Scroll targets (View.ScrollTarget): a view laid over a scroll view, not
+// in it, gets a vertical pan recognizer of its own that moves the
+// target's content as the finger goes, stretching past its edges as
+// UIScrollView does, and lets it glide on at UIKit's normal deceleration,
+// all on the main thread without a trip through the core. Once the pan
+// begins, UIKit cancels the touches of the views under the finger. A
+// display link asking for the screen's full rate runs from the drag's start
+// to the glide's end: a ProMotion screen otherwise shows the moves at 60 Hz,
+// where a scroll view's own drag goes at 120.
+
+var (
+	selHandScroll = sel("nsgoHandScroll:")
+	selHandGlide  = sel("nsgoHandGlide:")
+)
+
+// decelerationRate is UIScrollViewDecelerationRateNormal, the speed kept
+// per millisecond.
+const decelerationRate = 0.998
+
+// handScroll is a view's hand off of the scrolls that begin on it.
+type handScroll struct {
+	pan    objc.ID // its UIPanGestureRecognizer
+	target *view   // the scroll view the drag or glide moves
+	from   float64 // the target's offset as the drag began
+	link   objc.ID // the CADisplayLink of the drag and glide, retained
+	glides bool    // whether the link steps a glide
+	speed  float64 // the glide's, in points per second
+	last   float64 // the glide's last frame timestamp
+}
+
+func handScrollMethods() []objc.MethodDef {
+	return []objc.MethodDef{
+		{Cmd: selHandScroll, Fn: handScrolled},
+		{Cmd: selHandGlide, Fn: handGlided},
+	}
+}
+
+// setScrollTarget adds or removes v's pan for its ScrollTarget.
+func (v *view) setScrollTarget(target driver.NodeID) {
+	switch {
+	case target != 0 && v.hand == nil:
+		r := objc.ID(apple.Class("UIPanGestureRecognizer")).Send(selAlloc).Send(sel("initWithTarget:action:"), v.native, selHandScroll)
+		r.Send(selSetDeleg, v.native)
+		v.native.Send(sel("addGestureRecognizer:"), r)
+		r.Send(selRelease)
+		v.hand = &handScroll{pan: r}
+	case target == 0 && v.hand != nil:
+		v.hand.stopGlide()
+		v.native.Send(sel("removeGestureRecognizer:"), v.hand.pan)
+		v.hand = nil
+	}
+}
+
+// scrollTarget returns the live scroll view v hands its scrolls to, or nil.
+func (v *view) scrollTarget() *view {
+	t := v.surface.viewOf(v.props.ScrollTarget)
+	if t == nil || t.sc == nil || t.sc.config.Horizontal {
+		return nil
+	}
+	return t
+}
+
+// handShouldBegin lets the pan begin on a drag that goes more up or down
+// than sideways, while v has a target.
+func handShouldBegin(v *view, r objc.ID) bool {
+	if v.scrollTarget() == nil {
+		return false
+	}
+	d := objc.Send[apple.CGPoint](r, selVelocity, v.native)
+	return math.Abs(d.Y) > math.Abs(d.X)
+}
+
+func handScrolled(self objc.ID, _ objc.SEL, r objc.ID) {
+	v := views[self]
+	if v == nil || v.hand == nil {
+		return
+	}
+	h := v.hand
+	switch objc.Send[int](r, selState) {
+	case stateBegan:
+		h.stopGlide()
+		t := v.scrollTarget()
+		if t == nil {
+			return
+		}
+		h.target = t
+		at := objc.Send[apple.CGPoint](t.native, selContentOffset)
+		if objc.Send[bool](t.native, sel("isDecelerating")) {
+			// Caught while gliding: stop where it is.
+			t.native.Send(sel("setContentOffset:animated:"), at, false)
+			t.scrollEvent(driver.EventMomentumEnd)
+		}
+		h.from = at.Y
+		h.run(v)
+		t.scrollEvent(driver.EventScrollDragStart)
+	case stateChanged:
+		if t := h.live(); t != nil {
+			d := objc.Send[apple.CGPoint](r, selTranslation, v.surface.native)
+			h.place(stretched(t.native, h.from-d.Y))
+		}
+	case stateEnded, stateCancelled, stateFailed:
+		t := h.live()
+		if t == nil {
+			h.stopLink()
+			return
+		}
+		t.scrollEvent(driver.EventScrollDragEnd)
+		start, end := scrollLimits(t.native)
+		at := objc.Send[apple.CGPoint](t.native, selContentOffset)
+		if at.Y < start.Y || at.Y > end.Y {
+			// Stretched past an edge: spring back, which UIKit reports as
+			// scrollViewDidEndScrollingAnimation.
+			at.Y = min(max(at.Y, start.Y), end.Y)
+			h.stopLink()
+			t.native.Send(sel("setContentOffset:animated:"), at, true)
+			return
+		}
+		speed := -objc.Send[apple.CGPoint](r, selVelocity, v.surface.native).Y
+		if math.Abs(speed) < 20 {
+			h.stopLink()
+			h.target = nil
+			t.scrollEvent(driver.EventScrollEnd)
+			return
+		}
+		h.glides, h.speed, h.last = true, speed, 0
+		t.scrollEvent(driver.EventMomentumStart)
+	}
+}
+
+// handGlided steps a glide one frame, until it slows to rest, meets an
+// edge or the finger takes the scroll view; during the drag it only keeps
+// the screen at its full rate.
+func handGlided(self objc.ID, _ objc.SEL, link objc.ID) {
+	v := views[self]
+	if v == nil || v.hand == nil {
+		link.Send(sel("invalidate"))
+		return
+	}
+	h := v.hand
+	if !h.glides {
+		return
+	}
+	t := h.live()
+	if t == nil {
+		h.stopGlide()
+		return
+	}
+	if objc.Send[bool](t.native, sel("isTracking")) {
+		// Caught by the finger: the scroll view's own drag goes on from here.
+		h.stopGlide()
+		return
+	}
+	now := objc.Send[float64](link, sel("targetTimestamp"))
+	if h.last == 0 {
+		h.last = objc.Send[float64](link, selTimestamp)
+	}
+	dt := now - h.last
+	h.last = now
+	h.speed *= math.Pow(decelerationRate, dt*1000)
+	start, end := scrollLimits(t.native)
+	at := objc.Send[apple.CGPoint](t.native, selContentOffset)
+	y := at.Y + h.speed*dt
+	edge := y <= start.Y || y >= end.Y
+	h.place(min(max(y, start.Y), end.Y))
+	if edge || math.Abs(h.speed) < 10 {
+		h.stopGlide()
+	}
+}
+
+// place moves the target's content to offset y.
+func (h *handScroll) place(y float64) {
+	at := objc.Send[apple.CGPoint](h.target.native, selContentOffset)
+	at.Y = y
+	h.target.native.Send(sel("setContentOffset:"), at)
+}
+
+// live returns the target of the drag or glide while it is alive.
+func (h *handScroll) live() *view {
+	t := h.target
+	if t == nil || t.surface.viewOf(t.id) != t {
+		h.target = nil
+		return nil
+	}
+	return t
+}
+
+// run starts the display link on v, at the screen's full rate.
+func (h *handScroll) run(v *view) { h.link = v.surface.fullRateLink(v.native, selHandGlide) }
+
+// stopLink stops the display link.
+func (h *handScroll) stopLink() {
+	if h.link != 0 {
+		stopLink(h.link)
+		h.link = 0
+	}
+}
+
+// stopGlide ends a drag or glide, reporting a glide at rest.
+func (h *handScroll) stopGlide() {
+	h.stopLink()
+	if !h.glides {
+		return
+	}
+	h.glides = false
+	if t := h.live(); t != nil {
+		t.scrollEvent(driver.EventMomentumEnd)
+		t.scrollEvent(driver.EventScrollEnd)
+	}
+	h.target = nil
+}
+
+// stretched is where offset y shows scroll view n, past its edges giving
+// way less the further it goes, as UIScrollView's rubber band.
+func stretched(n objc.ID, y float64) float64 {
+	start, end := scrollLimits(n)
+	d := objc.Send[apple.CGRect](n, selBounds).Size.Height
+	band := func(x float64) float64 { return (1 - 1/(x*0.55/d+1)) * d }
+	switch {
+	case y < start.Y:
+		return start.Y - band(start.Y-y)
+	case y > end.Y:
+		return end.Y + band(y-end.Y)
+	}
+	return y
+}
