diff --git a/internal/platform/macos/wheel.go b/internal/platform/macos/wheel.go
index 1b3856e7..00425eca 100644
--- a/internal/platform/macos/wheel.go
+++ b/internal/platform/macos/wheel.go
@@ -577,10 +577,22 @@ func (s *surface) scrollsAt(event objc.ID) []*view {
 	hit := s.native.Send(sel("hitTest:"), p)
 	rawHit = false
 	var out []*view
+	jumped := false
 	for n := hit; n != 0 && n != up; n = n.Send(selSuperview) {
-		if v := views[n]; v != nil && v.native == n && s.alive(v) {
+		v := views[n]
+		if v == nil || v.native != n || int(v.id) >= len(s.views) || s.views[v.id] != v {
+			continue
+		}
+		if v.sc != nil {
 			out = append(out, v)
 		}
+		// A view over a scroll view rather than in it hands its scrolls to
+		// it (View.ScrollTarget): the chain goes on from there.
+		if t := v.props.ScrollTarget; t != 0 && !jumped && int(t) < len(s.views) && s.alive(s.views[t]) {
+			jumped = true
+			n = s.views[t].native
+			out = append(out, s.views[t])
+		}
 	}
 	return out
 }
