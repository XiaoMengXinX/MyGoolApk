 core/element.go                               | 10 +++
 core/nav_test.go                              | 27 +++++++
 core/tree.go                                  | 17 ++++-
 docs/roadmap.md                               |  1 +
 internal/driver/mount.go                      |  3 +
 .../android/java/dev/oneo/nsgo/NsgoView.java  | 72 +++++++++++++++++++
 internal/platform/android/protocol.go         |  1 +
 internal/platform/macos/wheel.go              | 14 +++-
 9 files changed, 161 insertions(+), 3 deletions(-)

diff --git a/core/commit.go b/core/commit.go
index c74ccb0f..50f97998 100644
--- a/core/commit.go
+++ b/core/commit.go
@@ -305,6 +305,7 @@ func (t *Tree) commitRound() {
 	t.emitHeaderViews()
 	t.checkPointerLock()
 	t.makeCommanded()
+	t.resolveScrollTargets()
 	t.emit(t.view)
 	t.syncPaced()
 	for _, n := range t.transits {
@@ -1416,3 +1417,21 @@ func increasingRun(seq []int) []bool {
 	}
 	return stay
 }
+
+// resolveScrollTargets reads each View.ScrollTarget, which may name another
+// scroll view as the one shown changes, and sends a view whose target
+// changed again.
+func (t *Tree) resolveScrollTargets() {
+	for n := range t.scrollTargets {
+		var id NodeID
+		var ref *Ref
+		t.within(n.owner, func() { ref = Untracked(n.owner, n.scrollTarget) })
+		if ref.placed() && ref.n.kind == driver.KindScroll {
+			id = ref.n.id
+		}
+		if id != n.props.ScrollTarget {
+			n.props.ScrollTarget = id
+			t.touch(n)
+		}
+	}
+}
diff --git a/core/element.go b/core/element.go
index a8a43df3..5203b2a1 100644
--- a/core/element.go
+++ b/core/element.go
@@ -113,6 +113,16 @@ type View struct {
 	HitSlop Edges
 	// HitSlopFunc is HitSlop following what it reads.
 	HitSlopFunc func() Edges
+	// ScrollTarget, when set, names the scroll view that scrolls do over
+	// this view: what lies over a scroll view rather than in it, as a head
+	// over lists, scrolls it as if it were under the pointer or the finger.
+	// A desktop's wheel and touchpad over the view go to it, and a drag on a
+	// touch screen that starts on the view and goes along the scroll view's
+	// axis drags it, with the platform's own feel and glide; views inside
+	// that take the drag, as a scroll view across it, keep it. It is read
+	// at each commit, so it may name the scroll view shown now; nil, or one
+	// not shown, leaves scrolls to the views under them.
+	ScrollTarget func() *Ref
 	// DelayLongPress is how long a press is held to be a long press; 0
 	// is 500 ms.
 	DelayLongPress time.Duration
diff --git a/core/nav_test.go b/core/nav_test.go
index 9b55f85b..7783b5b0 100644
--- a/core/nav_test.go
+++ b/core/nav_test.go
@@ -922,3 +922,30 @@ func TestCoveredScreenKeepsItsLayout(t *testing.T) {
 			home.frame, frame, h.find("text").text.box, box, len(h.find("list").children), rows)
 	}
 }
+
+func TestScrollTargetNamesTheScrollViewShown(t *testing.T) {
+	var a, b Ref
+	var shown *Signal[int]
+	h := newPhone(t, phone, func(cx *Scope) Node {
+		shown = NewSignal(cx, 0)
+		return View{Style: Style{FlexGrow: 1}, Children: []Node{
+			Scroll{Ref: &a, TestID: "a", Style: Style{Height: Pt(100)}},
+			Scroll{Ref: &b, TestID: "b", Style: Style{Height: Pt(100)}},
+			View{TestID: "head", ScrollTarget: func() *Ref {
+				if shown.Get() == 0 {
+					return &a
+				}
+				return &b
+			}},
+		}}
+	})
+	h.commit()
+	if got := h.find("head").props.ScrollTarget; got != h.find("a").id {
+		t.Errorf("head's scroll target = %v, want a's %v", got, h.find("a").id)
+	}
+	shown.Set(1)
+	h.commit()
+	if got := h.find("head").props.ScrollTarget; got != h.find("b").id {
+		t.Errorf("head's scroll target = %v after b is shown, want b's %v", got, h.find("b").id)
+	}
+}
