         n.labelledBy = new int[in.readInt()];
         for (int i = 0; i < n.labelledBy.length; i++) n.labelledBy[i] = in.readInt();
         n.level = in.readInt();
+        n.scrollTarget = in.readInt();
         if (n.view instanceof TextNode) ((TextNode) n.view).selectable(selectable, Text.argb(selectionColor));
         View view = n.accessible();
         // A text field's ItemInput enables it.
@@ -7101,6 +7102,16 @@ public class NsgoView extends FrameLayout implements NsgoEngine.Listener {
         }
         /** The child a touch outside every child went to by its hit slop or area, until it lifts. */
         private View routed;
+        /**
+         * A drag that went down on a view with a scroll target
+         * (core.View.ScrollTarget): where it went down on the screen, the
+         * scroll view it is handed to once it goes along its axis, and
+         * whether a view inside took it first.
+         */
+        private float handDownX, handDownY;
+        private long handDownTime;
+        private FrameLayout handedTo;
+        private boolean handKept;
         /** Whether the touch reached the group outside its bounds and slop: only children may take it. */
         boolean childrenOnly;
 
@@ -7139,6 +7150,7 @@ public class NsgoView extends FrameLayout implements NsgoEngine.Listener {
         public boolean dispatchTouchEvent(MotionEvent e) {
             int action = e.getActionMasked();
             if (node != null && node.pointerEvents == Protocol.POINTER_EVENTS_NONE) return false;
+            if (node != null && node.scrollTarget != 0 && handScroll(e)) return true;
             if (action == MotionEvent.ACTION_DOWN) routed = route(e);
             if (routed != null) {
                 if (action != MotionEvent.ACTION_DOWN) deliver(routed, e);
@@ -7219,8 +7231,66 @@ public class NsgoView extends FrameLayout implements NsgoEngine.Listener {
             return taken;
         }
 
+        /**
+         * Hands a vertical drag that went down on this view to its scroll
+         * target, which drags and glides as if the finger had gone down on
+         * it: the views inside get a cancel, and the scroll view the touch
+         * from where it went down on, in its own coordinates. A view inside
+         * that took the drag, as a scroll view across it does, keeps it.
+         * Reports whether it took e.
+         */
+        private boolean handScroll(MotionEvent e) {
+            int action = e.getActionMasked();
+            if (action == MotionEvent.ACTION_DOWN) {
+                handDownX = e.getRawX();
+                handDownY = e.getRawY();
+                handDownTime = e.getDownTime();
+                handedTo = null;
+                handKept = false;
+                return false;
+            }
+            if (handedTo != null) {
+                handTo(handedTo, action, e.getRawX(), e.getRawY(), e.getEventTime());
+                if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) handedTo = null;
+                return true;
+            }
+            if (action != MotionEvent.ACTION_MOVE || handKept || e.getPointerCount() > 1) return false;
+            float dx = e.getRawX() - handDownX, dy = e.getRawY() - handDownY;
+            if (Math.abs(dy) <= ViewConfiguration.get(getContext()).getScaledTouchSlop() || Math.abs(dy) <= Math.abs(dx)) return false;
+            Node target = nodes.get(node.scrollTarget);
+            if (target == null || !(target.scroller instanceof Scrolling.VScroll) || !target.scroller.isAttachedToWindow()) return false;
+            // The views inside lose the touch, as when a scroll view around them takes it.
+            MotionEvent cancel = MotionEvent.obtain(e);
+            cancel.setAction(MotionEvent.ACTION_CANCEL);
+            super.dispatchTouchEvent(cancel);
+            cancel.recycle();
+            routed = null;
+            childrenOnly = false;
+            handedTo = target.scroller;
+            handTo(handedTo, MotionEvent.ACTION_DOWN, handDownX, handDownY, handDownTime);
+            handTo(handedTo, MotionEvent.ACTION_MOVE, e.getRawX(), e.getRawY(), e.getEventTime());
+            return true;
+        }
+
+        /** A view with a scroll target holds back its children's pressed look, as a scroll view does, until the touch is no drag. */
+        @Override
+        public boolean shouldDelayChildPressedState() {
+            return node != null && node.scrollTarget != 0;
+        }
+
+        /** Sends `to` a one-finger event at a point on the screen, in its coordinates. */
+        private void handTo(FrameLayout to, int action, float rawX, float rawY, long time) {
+            int[] at = new int[2];
+            to.getLocationOnScreen(at);
+            MotionEvent ev = MotionEvent.obtain(handDownTime, time, action, rawX - at[0], rawY - at[1], 0);
+            to.dispatchTouchEvent(ev);
+            ev.recycle();
+        }
+
         @Override
         public void requestDisallowInterceptTouchEvent(boolean disallow) {
+            // A view inside took the drag: a scroll target leaves it there.
+            if (disallow) handKept = true;
             // A descendant, such as a scroll view, took the touch first.
             if (disallow && !gestures.claiming) touchesTaken();
             if (disallow && node != null && !gestures.claiming) gestures.lost(node, false);
@@ -7887,6 +7957,8 @@ public class NsgoView extends FrameLayout implements NsgoEngine.Listener {
         boolean invalid, labelPress;
         int labelFor;
         int[] labelledBy = new int[0];
+        /** The scroll view a drag starting on the view goes to (core.View.ScrollTarget), 0 for none. */
+        int scrollTarget;
         String label = "", text = "", testID = "";
         /** Accessibility beyond the role, label and states, as core.ViewProps has it. */
         String hint = "", valueText = "";
